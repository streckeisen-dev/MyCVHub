    "@tailwindcss/vite": "4.2.2",
    "clsx": "2.1.1",
    "framer-motion": "12.38.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.4",
    "lodash.debounce": "^4.0.8",
    "moment": "^2.30.1",
    "react": "19.2.4",
